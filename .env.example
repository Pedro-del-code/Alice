# Copie para .env e preencha. NUNCA versione o arquivo .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Senha do painel /admin (defina aqui ou no Render; NUNCA no código). Prefira 12+ caracteres.
ADMIN_PASSWORD=
# Token para acesso por script (curl) às rotas /api/admin/*. Longo e aleatório.
ADMIN_TOKEN=
# Assina o cookie de sessão do painel (opcional; se vazio é derivado da senha)
ALICE_SECRET_KEY=
ALICE_DB_PATH=data/alice.db
ALICE_BACKUP_DIR=
# Limites (o plano gratuito do Groq tem teto diário de tokens; confira no console)
ALICE_DAILY_TOKEN_BUDGET=150000
ALICE_RPM_LIMIT=25
ALICE_IP_RPM_LIMIT=12
# Retenção e backup
ALICE_RETENTION_DAYS=90
ALICE_BACKUP_KEEP=7
# Autonomia (Fase 3): off por padrão localmente
ALICE_SCHEDULER=off
ALICE_AUTONOMY=off
ALICE_CYCLE_INTERVAL_MIN=180
ALICE_CYCLES_PER_DAY=6
ALICE_CYCLE_USAGE_CEILING=0.6
# Em produção atrás de proxy (Render)
ALICE_BEHIND_PROXY=0

# Pensamento interno antes de responder (on/off) e retenção dos pensamentos ligados a visitantes
ALICE_DELIBERATE=on
ALICE_THOUGHT_RETENTION_DAYS=7

# Fuso do administrador (ritmo do dia). Brasil/Brasília = -3
ALICE_TZ_OFFSET_HOURS=-3
# Opcional: embeddings reais (API compatível com OpenAI). Deixe vazio para usar o vetor local.
ALICE_EMBED_URL=
ALICE_EMBED_KEY=
ALICE_EMBED_MODEL=text-embedding-3-small

# Persistência no plano gratuito do Render: armazenamento externo compatível com S3 (bucket PRIVADO)
ALICE_S3_ENDPOINT=
ALICE_S3_BUCKET=
ALICE_S3_REGION=us-east-1
ALICE_S3_ACCESS_KEY=
ALICE_S3_SECRET_KEY=
ALICE_S3_PREFIX=alice
# Frase longa que criptografa o backup antes de enviar. GUARDE-A: sem ela não há restauração.
ALICE_BACKUP_PASSPHRASE=
ALICE_REMOTE_SYNC_MIN=5
